        {
          "id": "Panel_007",
          "type": "stacked",
          "title": "Error logs",
          "description": "Log lines at ERROR or FATAL: Mautic's own log (its logs sidecar) and offby1.cc's server errors.",
          "config": {
            "show_legends": true,
            "decimals": 2,
            "unit": "default"
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) as \"x_axis_1\", k8s_namespace_name as \"breakdown_1\", count(_timestamp) as \"y_axis_1\" FROM \"default\" WHERE k8s_namespace_name IN ('mautic', 'offby1-cc', 'artistlabco-com') AND severity IN ('ERROR', 'FATAL') GROUP BY x_axis_1, breakdown_1 ORDER BY x_axis_1 ASC",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "logs",
                "x": [],
                "y": [],
                "z": [],
                "breakdown": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
