    {
      "type": "table",
      "title": "Volumes",
      "description": "Each volume once: robustness, size, use, and the age of its last Longhorn backup.",
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (volume, state) (longhorn_volume_robustness == 1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (volume) (longhorn_volume_capacity_bytes)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (volume) (longhorn_volume_actual_size_bytes)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max by (volume) (longhorn_volume_last_backup_at > 0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E7ECF3",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "robustness"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "healthy": {
                        "color": "#34D399",
                        "text": "● healthy"
                      },
                      "degraded": {
                        "color": "#FBBF24",
                        "text": "● degraded"
                      },
                      "faulted": {
                        "color": "#FB7185",
                        "text": "● faulted"
                      },
                      "unknown": {
                        "color": "#8D99AB",
                        "text": "● detached"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "size"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last backup"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#E7ECF3",
                      "value": null
                    },
                    {
                      "color": "#FBBF24",
                      "value": 172800
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "robustness",
            "desc": false
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "volume": 0,
              "state": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "state": "robustness",
              "Value #B": "size",
              "Value #C": "used",
              "Value #D": "last backup"
            }
          }
        }
      ],
