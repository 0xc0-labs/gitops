          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(increase(traefik_entrypoint_requests_total{entrypoint=~\"$entrypoint\", code=~\"5..\"}[$__range])) or vector(0)",
          "editorMode": "code",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "sum(increase(traefik_entrypoint_requests_total{entrypoint=~\"$entrypoint\", code=~\"4..\"}[$__range])) or vector(0)",
          "editorMode": "code",
          "range": false,
