        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(traefik_entrypoint_request_duration_seconds_bucket{entrypoint=~\"$entrypoint\"}[$__range]))) and on () (sum(increase(traefik_entrypoint_request_duration_seconds_count{entrypoint=~\"$entrypoint\"}[$__range])) >= 20)",
          "editorMode": "code",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "F",
          "expr": "count(sum by (exported_service) (increase(traefik_service_requests_total[$__range])) > 0) or vector(0)",
          "editorMode": "code",
          "range": false,
          "instant": true
