            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(traefik_entrypoint_requests_total{entrypoint=~\"$entrypoint\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#60A5FA"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E7ECF3",
                "value": null
              }
            ]
          }
        },
        "overrides": []
