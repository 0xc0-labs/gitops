    {
      "type": "volkovlabs-echarts-panel",
      "title": "",
      "description": "Vault's state now, and its requests over the range.",
      "transparent": true,
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "maxDataPoints": 48,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(vault_core_unsealed{job=\"vault-active\"})",
