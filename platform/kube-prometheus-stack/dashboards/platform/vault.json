    {
      "type": "stat",
      "title": "Seal",
      "description": "vault_core_unsealed on the active node.",
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(vault_core_unsealed{job=\"vault-active\"})",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#FB7185",
                "value": null
              },
              {
                "color": "#34D399",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "unsealed"
                },
                "0": {
                  "text": "sealed"
                }
              }
            }
          ]
        },
        "overrides": []
