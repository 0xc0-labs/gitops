  "panels": [
    {
      "type": "volkovlabs-echarts-panel",
      "title": "",
      "description": "Argo CD's applications now, and its syncs over the range (argocd_app_sync_total).",
      "transparent": true,
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "maxDataPoints": 48,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
