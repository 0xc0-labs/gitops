    {
      "id": 11,
      "type": "heatmap",
      "title": "p95 latency by service",
      "description": "Distribution of the service graph's server-side request duration over time; hot cells are slow.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "expr": "sum by (le) (rate(traces_service_graph_request_server_seconds_bucket[$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "scale": "exponential",
          "fill": "dark-orange",
          "steps": 64,
          "reverse": false
        },
        "yAxis": {
          "unit": "s"
        },
        "cellGap": 1,
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": false
        },
        "rowsFrame": {
          "layout": "auto"
        }
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Busiest namespaces by CPU",
      "description": "CPU cores used per namespace, top 8.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(8, sum by (namespace) (rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])))",
