          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(grafana_alerting_alerts{state=\"alerting\"}) or vector(0)) + (count(ALERTS{alertstate=\"firing\"}) or vector(0))",
