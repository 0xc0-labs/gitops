{
  "uid": "kubernetes-events",
  "title": "Kubernetes / Events",
  "tags": [
    "kubernetes",
    "events"
  ],
  "description": "What is happening in the cluster: Kubernetes events, from Loki.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "piechart",
      "title": "Severity",
      "description": "The collectors' gateway sends the Kubernetes events to Loki. Assumes they arrive as JSON log lines with service_name unknown_service. Severity is the event's type, Normal or Warning.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (object_type) (count_over_time({service_name=\"unknown_service\"} | json | object_reason != \"\" [$__range]))",
          "legendFormat": "{{object_type}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "barchart",
      "title": "Severity by namespace",
      "description": "The collectors' gateway sends the Kubernetes events to Loki. Assumes they arrive as JSON log lines with service_name unknown_service.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (object_metadata_namespace, object_type) (count_over_time({service_name=\"unknown_service\"} | json | object_reason != \"\" [$__range]))",
          "legendFormat": "{{object_metadata_namespace}} {{object_type}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": 0
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Event reason by namespace",
      "description": "The collectors' gateway sends the Kubernetes events to Loki. Assumes they arrive as JSON log lines with service_name unknown_service.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (object_reason, object_metadata_namespace) (count_over_time({service_name=\"unknown_service\"} | json | object_reason != \"\" [$__auto]))",
          "legendFormat": "{{object_reason}} {{object_metadata_namespace}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "table",
      "title": "Events",
      "description": "The collectors' gateway sends the Kubernetes events to Loki. Assumes they arrive as JSON log lines with service_name unknown_service. Counts for the range, by namespace, type and reason.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (object_metadata_namespace, object_type, object_reason) (count_over_time({service_name=\"unknown_service\"} | json | object_reason != \"\" [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      }
    }
  ]
}
