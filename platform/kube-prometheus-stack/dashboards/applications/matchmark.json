    {
      "type": "stat",
      "title": "API requests / s",
      "description": "matchmark-api's own request metrics.",
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"matchmark-api\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "color": {
            "mode": "fixed",
            "fixedColor": "#60A5FA"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E7ECF3",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
