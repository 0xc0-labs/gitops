    {
      "type": "stat",
      "title": "Page loads",
      "description": "Navigations: one TTFB measurement each, from Faro.",
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"$app\"} | kind=\"measurement\" | logfmt | type=\"web-vitals\" | app_environment!=\"probe\" | value_ttfb!=\"\" [$__auto]))",
          "queryType": "range",
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#60A5FA"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E7ECF3",
                "value": null
              }
            ]
          },
          "noValue": "no visits in range"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
