      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "maxDataPoints": 48,
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${service:raw}\"} | count_over_time()",
          "metricsQueryType": "range",
          "step": "1h"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "B",
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${service:raw}\" && status = error} | count_over_time()",
          "metricsQueryType": "range",
          "step": "1h"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "C",
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${service:raw}\" && kind = server} | histogram_over_time(duration)",
          "metricsQueryType": "range",
          "step": "1h"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "D",
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${service:raw}\" && kind = server} | max_over_time(duration)",
          "metricsQueryType": "range",
          "step": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E7ECF3",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "renderer": "canvas",
        "map": "none",
        "themeEditor": {
          "name": "dark",
          "config": "{}"
        },
        "editor": {
          "format": "auto"
        },
        "editorMode": "code",
        "getOption": "const MONO = \"'JetBrains Mono', 'Roboto Mono', ui-monospace, monospace\";\nconst cards = [\n  { label: 'Spans', fmt: 'count', value: () => total('A'), sub: (v) => (v === null ? 'none · ' + span : Math.round(v / hours).toLocaleString('en-US') + ' per hour · ' + span), spark: 'A', sparkColour: '#60A5FA' },\n  { label: 'Error spans', fmt: 'count', value: () => (total('A') === null ? null : total('B') || 0), sub: (v) => (v === null ? 'no spans' : (100 * v / total('A')).toFixed(2) + ' % of spans'), colour: (v) => (v > 0 ? '#FBBF24' : '#E7ECF3') },\n  { label: 'p95', fmt: 'dur', value: () => quantile('C', 0.95, 20), sub: (v) => (v === null ? 'under 20 server spans' : 'server spans · ' + span), colour: (v) => (v >= 1 ? '#FB7185' : v >= 0.5 ? '#FBBF24' : '#E7ECF3') },\n  { label: 'Max duration', fmt: 'dur', value: () => most('D'), sub: (v) => (v === null ? 'no server spans' : 'slowest server span') },\n];\nconst frames = context.panel.data.series;\nconst byRef = (id) => frames.filter((f) => f.refId === id);\nconst num = (x) => (x === null || x === undefined || !Number.isFinite(Number(x)) ? null : Number(x));\nconst last = (id) => {\n  for (const f of byRef(id)) {\n    const v = f.fields.find((x) => x.type === 'number');\n    if (!v) continue;\n    for (let i = v.values.length - 1; i >= 0; i--) { const n = num(v.values[i]); if (n !== null) return n; }\n  }\n  return null;\n};\nconst total = (id, keep) => {\n  let s = 0;\n  let any = false;\n  for (const f of byRef(id)) {\n    const v = f.fields.find((x) => x.type === 'number');\n    if (!v || (keep && !keep(v.labels || {}))) continue;\n    for (const x of v.values) { const n = num(x); if (n !== null) { s += n; any = true; } }\n  }\n  return any ? s : null;\n};\nconst most = (id) => {\n  let m = null;\n  for (const f of byRef(id)) {\n    const v = f.fields.find((x) => x.type === 'number');\n    if (!v) continue;\n    for (const x of v.values) { const n = num(x); if (n !== null && (m === null || n > m)) m = n; }\n  }\n  return m;\n};\n// Tempo's histogram_over_time: one series per bucket, its upper bound in\n// seconds on __bucket, each bucket twice the one before. Counts are summed\n// over the range, then the quantile is interpolated inside its bucket, so it\n// never reads as a bucket edge.\nconst quantile = (id, q, minCount) => {\n  const b = new Map();\n  for (const f of byRef(id)) {\n    const v = f.fields.find((x) => x.type === 'number');\n    if (!v) continue;\n    const l = v.labels || {};\n    const name = String((v.config && v.config.displayNameFromDS) || v.name || f.name || '');\n    const ub = num(l.__bucket !== undefined ? l.__bucket : (name.match(/bucket[^0-9]*([0-9.eE+-]+)/) || [])[1]);\n    if (ub === null || ub <= 0) continue;\n    let c = 0;\n    for (const x of v.values) { const n = num(x); if (n !== null) c += n; }\n    b.set(ub, (b.get(ub) || 0) + c);\n  }\n  const ubs = [...b.keys()].sort((x, y) => x - y);\n  const count = ubs.reduce((s, u) => s + b.get(u), 0);\n  if (count < minCount) return null;\n  let acc = 0;\n  for (const u of ubs) {\n    const c = b.get(u);\n    if (c > 0 && acc + c >= q * count) return u / 2 + (u / 2) * ((q * count - acc) / c);\n    acc += c;\n  }\n  return null;\n};\nconst points = (id) => {\n  const f = byRef(id)[0];\n  if (!f) return [];\n  const t = f.fields.find((x) => x.type === 'time');\n  const v = f.fields.find((x) => x.type === 'number');\n  if (!t || !v) return [];\n  return t.values.map((x, i) => [x, num(v.values[i])]);\n};\nconst span = (() => {\n  const r = context.panel.data.timeRange;\n  if (!r) return '';\n  const m = (r.to.valueOf() - r.from.valueOf()) / 60000;\n  if (m < 90) return Math.round(m) + ' min';\n  if (m < 48 * 60) return Math.round(m / 60) + ' h';\n  return Math.round(m / 1440) + ' d';\n})();\nconst hours = (() => {\n  const r = context.panel.data.timeRange;\n  return r ? (r.to.valueOf() - r.from.valueOf()) / 3600000 : 1;\n})();\nconst fmt = {\n  count: (v) => [Math.round(v).toLocaleString('en-US'), ''],\n  pct: (v) => [(v * 100).toFixed(v * 100 >= 99.95 || v === 0 ? 2 : v * 100 < 10 ? 2 : 1), '%'],\n  dur: (v) => (v < 1 ? [String(Math.round(v * 1000)), 'ms'] : [v.toFixed(v < 10 ? 2 : 1), 's']),\n  num2: (v) => [v.toFixed(2), ''],\n  ms: (v) => (v < 1000 ? [String(Math.round(v)), 'ms'] : [(v / 1000).toFixed(2), 's']),\n  bytes: (v) => {\n    const u = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];\n    let i = 0;\n    while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; }\n    return [v.toFixed(v < 10 ? 2 : 1), u[i]];\n  },\n};\nconst n = cards.length;\nconst chart = context.panel.chart;\nconst W = chart && typeof chart.getWidth === 'function' ? chart.getWidth() : 0;\nconst H = chart && typeof chart.getHeight === 'function' ? chart.getHeight() : 0;\nconst gap = 12;\nconst cw = W ? (W - gap * (n - 1)) / n : 0;\nconst graphic = [];\nconst grid = [];\nconst xAxis = [];\nconst yAxis = [];\nconst series = [];\ncards.forEach((c, i) => {\n  const x = W ? i * (cw + gap) : 0;\n  const at = (dx) => (W ? x + dx : (i * 100) / n + 1.2 + '%');\n  const v = c.value();\n  const shown = v === null ? ['—', ''] : c.show ? c.show(v) : fmt[c.fmt](v);\n  const unit = v === null ? '' : c.unit !== undefined ? c.unit : shown[1];\n  const colour = v === null ? '#8D99AB' : c.colour ? c.colour(v) : '#E7ECF3';\n  if (W && H) graphic.push({ type: 'rect', left: x, top: 0, z: -1, silent: true,\n    shape: { width: cw, height: H - 1, r: 14 }, style: { fill: '#10151C', stroke: '#1F2733', lineWidth: 1 } });\n  const fit = W ? { width: cw - 32, overflow: 'truncate', ellipsis: '…' } : {};\n  graphic.push({ type: 'text', left: at(16), top: 12, silent: true,\n    style: Object.assign({ text: c.label.toUpperCase(), fill: '#8D99AB', font: '600 11px Inter, sans-serif' }, fit) });\n  graphic.push({ type: 'text', left: at(16), top: 28, silent: true,\n    style: { text: '{v|' + shown[0] + '}' + (unit ? '{u| ' + unit + '}' : ''),\n      rich: { v: { fill: colour, font: '600 30px ' + MONO },\n        u: { fill: '#8D99AB', font: '13px ' + MONO, padding: [12, 0, 0, 4] } } } });\n  const sub = c.sub ? c.sub(v) : '';\n  if (sub) graphic.push({ type: 'text', left: at(16), top: 68, silent: true,\n    style: Object.assign({ text: sub, fill: '#8D99AB', font: '12px ' + MONO }, fit) });\n  if (c.spark) {\n    const data = points(c.spark);\n    if (data.some((p) => p[1] !== null)) {\n      const g = grid.length;\n      const sh = H ? Math.max(14, H - 94) : 20;\n      grid.push(W ? { left: x + 12, width: cw - 24, bottom: 6, height: sh }\n        : { left: (i * 100) / n + 1.2 + '%', width: 100 / n - 2.4 + '%', bottom: 6, height: sh });\n      xAxis.push({ type: 'time', gridIndex: g, show: false });\n      yAxis.push({ type: 'value', gridIndex: g, show: false, scale: false, min: 0 });\n      series.push({ type: 'line', xAxisIndex: g, yAxisIndex: g, data, showSymbol: false, silent: true,\n        connectNulls: false, lineStyle: { width: 1.5, color: c.sparkColour || '#60A5FA' } });\n    }\n  }\n});\nreturn { backgroundColor: 'transparent', animation: false, graphic, grid, xAxis, yAxis, series };",
        "baidu": {
